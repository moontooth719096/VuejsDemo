@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<link href="~/lib/bootstrap-table/css/bootstrap-table.min.css" rel="stylesheet" />
<div id="YoutubeDonloadApp">
    <div class="row m-1">
        <input type="text" class="col-9 m-1" v-model="InputListID" />
        <button class="btn btn-primary col-1 m-1" :onclick="listget">Search</button>
    </div>
    <div class="row">
        <div class="row">
            <div>{{Donloadprogress.message}}</div>
        </div>
        <div class="row" v-show="SelectData">
            <button id="Download_Btn" :onclick="download" async>Download</button>
            <br />
            <div class="progress" v-show="Donloadprogress.progress>0">
                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" :aria-valuenow="Donloadprogress.progress" aria-valuemin="0" aria-valuemax="100" :style="{ width: Donloadprogress.progress+'%' }"></div>
            </div>
        </div>

        <table class="table table-hover">
            <tbody>
                <tr v-for="item in Data">
                    <td class="w-5 align-middle">
                        <input type="checkbox" :id="item.id" v-model="item.isCheck" />
                    </td>
                    <td class="w-15">
                        <a :href="item.url" target="_blank">
                            <img style="width:100px;" :src="item.thumbnailUrl" class="img-fluid img-thumbnail" alt="...">
                        </a>
                    </td>
                    <td class="w-auto align-middle">
                        {{ item.title }}
                    </td>
                    <td class="w-5 align-middle">
                        {{ item.playTime }}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    @*<script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>*@
    <script src="~/lib/bootstrap-table/js/bootstrap-table-vue.min.js"></script>
    @* <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script> *@
    <script src="~/js/common/apihelper.js"></script>
    @* <script src="~/js/signalr/dist/browser/signalr.js"></script> *@

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    InputListID: '',
                    Data: [],
                    SelectData: [],
                    isShowDownload: false,
                    Donloadprogress: {
                        progress: 0,
                        message: ''
                    },
                    hub: {
                        connection: {}
                        , HubConnId: ''
                    }
                }
            },
            mounted() {
                let self = this;
                self.hub.connection = new signalR.HubConnectionBuilder()
                    .withUrl("https://localhost:7068/youtubeDownloadProgressHub")
                    .build();

                // 更新進度
                self.hub.connection.on("YoutubeDownloadProgress", function (message, percent) {
                    self.DownloadBarProgress(message, percent);
                });
            },
            methods: {
                //取得音樂清單
                listget() {
                    let url = '/api/YoutubeDownload/PlayListGet?PlaylistId=' + this.InputListID;
                    let ApiBase = BaseApiBase();
                    ApiBase.get(url)
                        .then((response) => {
                            if (response.data.length > 0) {
                                this.Data = response.data;

                            }
                        })
                        .catch(function (error) { // 请求失败处理
                            console.log(error);
                        })
                },
                //執行音樂下載
                async download() {
                    let self = this;
                    //與Server建立連線
                    await this.hub.connection.start().then(async function () {
                        console.log("連線完成");
                        document.getElementById('Download_Btn').disabled = true;
                        this.isShowDownload = true;
                        //篩選有勾選的資料
                        let ndata = _.filter(this.Data, ['isCheck', true]);
                        //只取id 與 title欄位
                        this.SelectData = _.map(ndata, obj => _.pick(obj, ['id', 'title']));
                        let url = '/api/YoutubeDownload/Download';
                        let ApiBase = BaseApiBase();
                        let response;
                        try {
                            response = await ApiBase.post(url,
                                this.SelectData,
                                {
                                    responseType: 'blob'
                                })
                            
                        } catch (e) {
                            console.log(e);
                        }
                        self.downloadData(response);
                    }).catch(function (err) {
                        alert('連線錯誤: ' + err.toString());
                    });
                    this.hub.connection.stop().catch(function (err) {
                        console.log("結束連線");
                    });
                },
                //壓縮完後 下載檔案
                downloadData: function (data) {
                    if (!data) {
                        return
                    }
                    let url = window.URL.createObjectURL(new Blob([data.data]))
                    let link = document.createElement('a')
                    link.style.display = 'none'
                    link.href = url
                    //link.setAttribute('download', 'excel.xlsx')

                    let timestamp = new Date().getTime();
                    link.download = `${timestamp}.zip`;
                    document.body.appendChild(link);
                    link.click();
                    this.downloadComplate();
                    document.getElementById('Download_Btn').disabled = false;
                },
                //下載完成後設定
                downloadComplate: function () {
                    this.Donloadprogress.message = '檔案下載完成';
                    this.Donloadprogress.progress = 0;
                    this.Donloadprogress.message = '';
                    this.isShowDownload = false;
                },
                DownloadBarProgress: function (message, percent) {
                    if (percent == 100) {
                        this.Donloadprogress.message = '檔案壓縮中..';
                    } else {
                        this.Donloadprogress.progress = percent;
                        this.Donloadprogress.message = message + ' ' + percent + '%';
                    }
                }
            }
        }).mount('#YoutubeDonloadApp')
    </script>
}