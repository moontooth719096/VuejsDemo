@page
@inject IConfiguration Configuration;
@{
    ViewData["Title"] = "YTDownload";
}

<link href="~/lib/bootstrap-table/css/bootstrap-table.min.css" rel="stylesheet" />

<div id="YoutubeDonloadApp">
    <div class="row m-1">
        <input type="text" class="col-9 m-1" v-model="InputListID" />
        <button class="btn btn-primary col-1 m-1" :onclick="listget">Search</button>
        <button id="Download_Btn" class="btn btn-warning col-1 m-1" :onclick="download" v-show="SelectData">Download</button>
    </div>
    <div class="row">
        <div class="progress" v-show="Donloadprogress.progress">
            <div>{{Donloadprogress.message}}</div>
            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" v-bind:aria-valuenow="Donloadprogress.progress" aria-valuemin="0" aria-valuemax="100" :style="{ width: Donloadprogress.progress+'%' }"></div>
        </div>

        <table class="table table-hover">
            <tbody>
                <tr v-for="item in SearchList">
                    <td class="w-5 align-middle">
                        <input type="checkbox" :id="item.id" v-model="item.isCheck" />
                    </td>
                    <td class="w-15">
                        <a :href="item.url" target="_blank" v-bind>
                            <img style="width:100px;" :src="item.thumbnailUrl" class="img-fluid img-thumbnail" alt="...">
                        </a>
                    </td>
                    <td class="w-auto align-middle">
                        {{ item.title }}
                    </td>
                    <td class="w-5 align-middle">
                        {{ item.playTime }}
                    </td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

@section scripts{
    @* <script src="~/lib/bootstrap-table/js/bootstrap-table.min.js"></script> *@
    <script>
        var appSettings = {
            API_BASE:'@Configuration["APIsetting:BaseUrl"]',
            YTDownloadHubUri: '@Configuration["APIsetting:YTDownloadHubUri"]',
            YTDownloadPlayListGetUri : '@Configuration["APIsetting:YTDownloadPlayListGetUri"]',
            YoutubeDownloadUri : '@Configuration["APIsetting:YoutubeDownloadUri"]'
        };
    </script>
    <script src="~/js/youtubedownload/youtubedownload.js" asp-append-version="true"></script>
}