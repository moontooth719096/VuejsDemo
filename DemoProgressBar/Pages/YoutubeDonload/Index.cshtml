@page

<div id="YoutubeDonloadApp" class="row g-0 mt-2 justify-content-center">
    <div class="row">
        <input type="text" class="col-9 m-1" v-model="InputListID" ref="urlinput"/>
        <button class="btn btn-primary col-1 m-1" :onclick="listget" v-bind:disabled="!InputListID">Search</button>
        <button id="Download_Btn" class="btn btn-warning col-1 m-1" :onclick="download" v-bind:disabled="SearchList.length<=0" ref="downloadbtn">Download</button>
    </div>
    <div class="row m-1">
        <div class="col-2">{{Donloadprogress.message}}</div>
        <div class="progress col">
            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" v-bind:aria-valuenow="Donloadprogress.progress" aria-valuemin="0" aria-valuemax="100" :style="{ width: Donloadprogress.progress+'%' }">{{Donloadprogress.progress+'%'}}</div>
        </div>
    </div>
    <div class="row m-1">
        <table class="table table-bordered table-hover">
            <tbody>
                <tr v-for="item in SearchList" style="height:15%">
                    <td class="w-5 align-middle text-center">
                        <input type="checkbox" :id="item.id" v-model="item.isCheck" />
                    </td>
                    <td class="w-auto text-center">
                        <a :href="item.url" target="_blank">
                            <img style="width:6.25rem;" :src="item.thumbnailUrl" class="img-fluid img-thumbnail" alt="...">
                        </a>
                    </td>
                    <td class="w-auto align-middle">
                        {{ item.title }}
                    </td>
                    <td class="w-5 align-middle text-center">
                        {{ item.playTime }}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <environment include="Development">
        <script src="~/js/youtubedownload/youtubedownload.js" asp-append-version="true"></script>
    </environment>
    <environment include="Production">
        <script src="~/js/youtubedownload/youtubedownload.es5.min.js" asp-append-version="true"></script>
    </environment>
}